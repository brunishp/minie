# Copy to .env (git-ignored) and fill in. Never commit the real token.
# Commands read it through: uv run --env-file .env minie <command>

# Developer Portal > your application > Bot > Reset Token.
DISCORD_TOKEN=

# Server where `minie sync` registers the commands (instant updates during development).
# Discord settings > Advanced > Developer Mode, then right-click the server > Copy Server ID.
MINIE_DEV_GUILD_ID=

# Optional; the values shown are the defaults.
# MINIE_DATA_DIR=data
# MINIE_LOG_LEVEL=INFO
# Trace voice gateway opcodes, IP discovery and DAVE/MLS messages (token and keys redacted).
# MINIE_VOICE_DEBUG=0
# MINIE_FFMPEG=ffmpeg
# MINIE_FFPROBE=ffprobe
# Path to the libopus shared library, only needed if it isn't found automatically.
# MINIE_OPUS_LIBRARY=
